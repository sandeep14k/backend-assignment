              "pm.test(\"one stop\", () => pm.expect(d.fuel_stops.length).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Invalid location -> 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Paris, FR\",\n  \"finish\": \"Chicago, IL\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/route/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400\", () => pm.response.to.have.status(400));",
              "pm.test(\"error code\", () => pm.expect(pm.response.json().code).to.eql(\"invalid_request\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Unknown field -> 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\",\n  \"mpg\": 20\n}",
