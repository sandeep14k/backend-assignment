          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/route/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"total cost equals sum of receipts\", () => { const s = d.fuel_stops.reduce((a, x) => a + Number(x.cost_usd), 0); pm.expect(s + Number(d.starting_fuel?.cost_usd || 0)).to.be.closeTo(Number(d.total_cost_usd), 0.001); });",
              "pm.test(\"tank never exceeds 50 gallons\", () => d.fuel_stops.forEach(x => pm.expect(x.gallons_on_departure).to.be.at.most(50.001)));",
              "pm.test(\"tank never runs dry\", () => d.fuel_stops.forEach(x => pm.expect(x.gallons_on_arrival).to.be.at.least(0)));",
              "pm.test(\"every stop explains itself\", () => d.fuel_stops.forEach(x => pm.expect(x.reason).to.be.a(\"string\").and.not.empty));",
              "pm.test(\"never costs more than a price-blind driver\", () => { if (d.savings.savings_usd !== null) pm.expect(Number(d.savings.savings_usd)).to.be.at.least(0); });",
              "console.log(`${d.distance_miles} mi, $${d.total_cost_usd}, ${d.fuel_stops.length} stops, ${d.metadata.timing_ms.total} ms, map: ${d.map_url}`);",
              "pm.test(\"fuel balance reconciles\", () => pm.expect(d.initial_fuel_gallons + d.fuel_purchased_gallons).to.be.closeTo(d.fuel_burned_gallons + d.remaining_gallons, 0.02));",
              "pm.test(\"stops routed by road\", () => pm.expect(d.metadata.itinerary_routed).to.eql(true));",
              "pm.test(\"at most 3 routing calls\", () => pm.expect(d.metadata.routing_calls).to.be.at.most(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "San Francisco -> Las Vegas -> 422 names the gap in the supplied price list",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
